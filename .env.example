# AWS Configuration
AWS_REGION=ap-south-1

# Cognito User Pool (used by scripts/auth/auth-cli.ts & scripts/benchmark/fanout-benchmark.ts)
USER_POOL_ID=ap-south-1_xxxxxxxxx
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_EMAIL=user@example.com
AUTH_PASSWORD=YourSecurePassword123!
COGNITO_ID_TOKEN=your_cognito_id_token

# Live WebSocket & DynamoDB Table (required for scripts/benchmark/fanout-benchmark.ts)
WS_URL=wss://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/dev
TABLE_NAME=dev-chat-table

# Local Integration Tests (DynamoDB Local)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Optional Fan-Out Benchmark Overrides (scripts/benchmark/fanout-benchmark.ts)
# MEMBER_COUNT=50
# WARMUP_ROUNDS=5
# TEST_ROUNDS=100
# BENCH_PASSWORD=Bench_Pass@2026!
# AUTH_TOKENS=token1,token2,...
