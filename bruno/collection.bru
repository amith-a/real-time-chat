headers {
  Authorization: Bearer {{idToken}}
}

script:pre-request {
  const axios = require('axios');

  const tokenExpiresAt = bru.getEnvVar('tokenExpiresAt');
  const refreshToken = bru.getEnvVar('refreshToken');
  const clientId = bru.getEnvVar('clientId');
  const region = bru.getEnvVar('region') || 'ap-south-1';
  const username = bru.getEnvVar('username');
  const password = bru.getEnvVar('password');

  // Do not intercept auth calls themselves
  const reqUrl = req.getUrl() || '';
  if (reqUrl.includes('cognito-idp')) {
    return;
  }

  // Check if token is missing, expired, or expiring within 60 seconds
  const isExpired = !tokenExpiresAt || Date.now() >= Number(tokenExpiresAt);

  if (isExpired && clientId) {
    let freshIdToken = null;

    // 1. Try Refresh Token first
    if (refreshToken) {
      try {
        const response = await axios.post(
          `https://cognito-idp.${region}.amazonaws.com/`,
          {
            AuthFlow: 'REFRESH_TOKEN_AUTH',
            ClientId: clientId,
            AuthParameters: {
              REFRESH_TOKEN: refreshToken,
            },
          },
          {
            headers: {
              'Content-Type': 'application/x-amz-json-1.1',
              'X-Amz-Target': 'AWSCognitoIdentityProviderService.InitiateAuth',
            },
          }
        );

        if (response.data && response.data.AuthenticationResult) {
          const { IdToken, AccessToken, ExpiresIn } = response.data.AuthenticationResult;
          bru.setEnvVar('idToken', IdToken);
          bru.setEnvVar('accessToken', AccessToken);
          
          const newExpiry = Date.now() + (ExpiresIn - 60) * 1000;
          bru.setEnvVar('tokenExpiresAt', newExpiry);
          freshIdToken = IdToken;
          console.log('[Bruno Auto-Auth] ID Token successfully refreshed via RefreshToken!');
        }
      } catch (err) {
        console.warn('[Bruno Auto-Auth] Refresh token failed or expired:', err.message);
      }
    }

    // 2. If refresh token was missing or failed, auto-login with username & password
    if (!freshIdToken && username && password) {
      try {
        const response = await axios.post(
          `https://cognito-idp.${region}.amazonaws.com/`,
          {
            AuthFlow: 'USER_PASSWORD_AUTH',
            ClientId: clientId,
            AuthParameters: {
              USERNAME: username,
              PASSWORD: password,
            },
          },
          {
            headers: {
              'Content-Type': 'application/x-amz-json-1.1',
              'X-Amz-Target': 'AWSCognitoIdentityProviderService.InitiateAuth',
            },
          }
        );

        if (response.data && response.data.AuthenticationResult) {
          const { IdToken, AccessToken, RefreshToken: newRefresh, ExpiresIn } = response.data.AuthenticationResult;
          bru.setEnvVar('idToken', IdToken);
          bru.setEnvVar('accessToken', AccessToken);
          if (newRefresh) {
            bru.setEnvVar('refreshToken', newRefresh);
          }
          const newExpiry = Date.now() + (ExpiresIn - 60) * 1000;
          bru.setEnvVar('tokenExpiresAt', newExpiry);
          freshIdToken = IdToken;
          console.log('[Bruno Auto-Auth] Automatically logged in via USER_PASSWORD_AUTH!');
        }
      } catch (err) {
        console.error('[Bruno Auto-Auth] Auto-login failed:', err.message);
      }
    }

    // 3. Ensure the current outgoing request uses the newly obtained token immediately
    if (freshIdToken && typeof req.setHeader === 'function') {
      req.setHeader('Authorization', `Bearer ${freshIdToken}`);
    }
  }
}
