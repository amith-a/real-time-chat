meta {
  name: Create Group Room
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rooms
  body: json
  auth: inherit
}

body:json {
  {
    "name": "General Chat",
    "members": [
      {
        "userId": "{{targetUserId}}",
        "role": "MEMBER"
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.roomId) {
    bru.setEnvVar('roomId', res.body.roomId);
    console.log('[Bruno] Created room ' + res.body.roomId + ' and saved to environment.');
  }
}
