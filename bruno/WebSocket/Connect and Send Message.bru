meta {
  name: Connect and Send Message
  type: ws
  seq: 5
}

ws {
  url: {{webSocket}}?token={{idToken}}
  body: ws
  auth: inherit
}

body:ws {
  name: sendMessage
  type: json
  content: '''
    {
      "action": "sendMessage",
      "roomId": "{{roomId}}",
      "messageId": "{{$guid}}",
      "body": "Hello from Bruno!"
    }
  '''
}
