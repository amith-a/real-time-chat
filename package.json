{
  "name": "real-time-chat",
  "version": "0.1.0",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/integration/**\"",
    "test:integration": "vitest run test/integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1176.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "@biomejs/biome": "2.5.15",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.10.1",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "zod": "^4.6.7"
  }
}
